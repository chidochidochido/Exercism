# ==========================================
# IDE & System Files
# ==========================================
.vscode/settings.json
.vscode/

# ==========================================
# Exercism Metadata
# ==========================================
# Ignore the exercism metadata directory in all exercises
**/.exercism/

# ==========================================
# Exercise Boilerplate & Documentation
# ==========================================
# Ignore instructions and help files inside exercise directories
*/*/HELP.md
*/*/README.md

# ==========================================
# Language-Specific Rules
# ==========================================

# --- C & C++ ---
# Ignore build configuration files inside exercise directories
*/*/makefile
*/*/CMakeLists.txt

# Ignore test frameworks and unit tests inside exercise directories
*/*/test-framework/
*/*/test_*.c
*/*/*_test.cpp
*/*/test/

# Ignore compiled binaries, objects, and debug symbols
*.o
*.out
*.exe
*.obj
*.pdb
*.gch

# --- Python ---
# Ignore python compilation and test caches
**/__pycache__/
**/.pytest_cache/
*.pyc
*.pyo
*.pyd

# --- Rust ---
# Ignore Rust build target directories and locks
**/target/
**/Cargo.lock
**/*.rs.bk

# --- Elixir ---
# Ignore Mix build directories, dependencies, and cover reports
**/_build/
**/deps/
**/cover/
**/doc/
**/.elixir_ls/
*.ez
erl_crash.dump

# ==========================================
# Miscellaneous / Specific Temp Files
# ==========================================
c/hamming/diffie-hellman.js

c/isogram/word-count.js
c/gigasecond/two_fer.go
